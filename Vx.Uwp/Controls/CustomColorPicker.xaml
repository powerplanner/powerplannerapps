<UserControl
    x:Class="InterfacesUWP.CustomColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InterfacesUWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <StackPanel Spacing="9">
        <TextBlock Text="{x:Bind Header, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap"/>

        <!-- Color Picker ComboBox-style Button -->
        <Button
            x:Name="ButtonPicker"
            HorizontalAlignment="Stretch" 
            HorizontalContentAlignment="Stretch"
            Padding="0">

            <!-- Style template to make the button look like a standard UWP input field -->
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
                </Style>
            </Button.Resources>

            <Grid Height="32" Padding="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Color Preview block + Text Label -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle x:Name="ColorPreviewRectangle" 
                           Width="16" Height="16" 
                           Fill="{x:Bind Color, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}" 
                           RadiusX="2" RadiusY="2" />
                    <TextBlock x:Name="ColorNameTextBlock" 
                           Text="#0000FF" 
                           VerticalAlignment="Center" />
                </StackPanel>

                <!-- Dropdown Chevron matching ComboBox/DatePicker style -->
                <FontIcon Grid.Column="1" 
                      Glyph="&#xE70D;" 
                      FontSize="12" 
                      Foreground="{ThemeResource TextControlForeground}"
                      VerticalAlignment="Center" />
            </Grid>

            <!-- The Pop-up Flyout containing the ColorPicker -->
            <Button.Flyout>
                <Flyout Placement="Bottom" Opening="Flyout_Opening">
                    <StackPanel Spacing="12" Width="280">
                        <!-- UWP Native ColorPicker -->
                        <ColorPicker
                            x:Name="MyColorPicker" 
                            ColorChanged="MyColorPicker_ColorChanged"
                            IsAlphaEnabled="False"
                            ColorSpectrumShape="Box" />

                        <!-- Confirmation / Close Button -->
                        <Button Content="Done" 
                            Click="Button_Click" 
                            HorizontalAlignment="Stretch" 
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
